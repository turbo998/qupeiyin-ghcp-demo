# ============================================================
# 趣配音 × GitHub Copilot Demo — 环境变量示例
# 复制为 .env 按需修改 (.env 已被 .gitignore 忽略, 不会进版本库)。
# 一键脚本默认值已能直接演示, 通常无需改动本文件。
# ============================================================

# ---- Demo 1: 打标签 ----
# 1 = 离线兜底 (读 mock-data/ideal_tags.json, 全程不联网, 现场断网首选)
# 0 = 在线调用 GitHub Copilot 模型
OFFLINE=0

# 在线模式调用的网关与模型 (默认走 GitHub Copilot)
LITELLM_BASE_URL=https://api.githubcopilot.com
DEFAULT_MODEL=claude-opus-4.8
FALLBACK_MODEL=gpt-5.5

# 可选: 覆盖 mock 数据目录 / 结果库路径 (一般不用改)
# MOCK_DATA_DIR=./mock-data
# RESULTS_DB=./demo1-auto-tagging/data/results.db

# 说明: 在线模式的鉴权 token 自动从 GitHub CLI 登录态读取
#       (~/.config/gh/hosts.yml 里的 oauth_token), 无需在此填写。
#       未登录 / 读不到 token 时, Demo1 会自动回退到离线兜底, 不会报错。
